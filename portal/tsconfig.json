{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@dashboard/*": ["../src/*"]
    }
  },
  "include": ["src", "../src/theme", "../src/components"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test", "../src/**/*.test.ts", "../src/**/*.test.tsx"]
}
