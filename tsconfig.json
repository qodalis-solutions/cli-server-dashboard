{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@qodalis/cli-server-dashboard-kit": ["./kit/src/index.ts"]
    }
  },
  "include": ["src", "kit/src", "kit/example/src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test", "kit/src/**/*.test.ts", "kit/src/**/*.test.tsx"]
}
