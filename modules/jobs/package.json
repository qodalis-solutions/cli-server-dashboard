{
  "name": "@qodalis/cli-dashboard-module-jobs",
  "version": "1.0.0-beta.31",
  "description": "Jobs page of the Qodalis CLI server dashboard: the scheduler's jobs and their runs, run charts, job details and actions, plus Overview cards and command palette entries. A dashboard extension the servers' jobs plugins embed",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qodalis-solutions/cli-server-dashboard.git",
    "directory": "modules/jobs"
  },
  "keywords": [
    "qodalis",
    "qodalis-cli",
    "dashboard",
    "jobs",
    "scheduler"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./extension.js": "./dist/extension.js",
    "./extension.css": "./dist/extension.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build"
  },
  "devDependencies": {
    "@qodalis/cli-server-dashboard-kit": "1.0.0-beta.31"
  },
  "qodalis": {
    "serverPackages": {
      "node": "@qodalis/cli-server-plugin-jobs",
      "python": "qodalis-cli-server-plugin-jobs",
      "dotnet": "Qodalis.Cli.Plugin.Jobs"
    }
  }
