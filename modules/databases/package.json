{
  "name": "@qodalis/cli-dashboard-module-databases",
  "version": "1.0.0-beta.30",
  "description": "Databases page of the Qodalis CLI server dashboard: each database's size, load and largest tables, its migrations and runs; applies and rolls back with a SQL preview. A dashboard extension the servers' databases plugins embed",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qodalis-solutions/cli-server-dashboard.git",
    "directory": "modules/databases"
  },
  "keywords": [
    "qodalis",
    "qodalis-cli",
    "dashboard",
    "databases",
    "migrations"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./extension.js": "./dist/extension.js",
    "./extension.css": "./dist/extension.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build"
  },
  "devDependencies": {
    "@qodalis/cli-server-dashboard-kit": "1.0.0-beta.30"
  },
  "qodalis": {
    "serverPackages": {
      "node": "@qodalis/cli-server-plugin-databases",
      "python": "qodalis-cli-server-plugin-databases",
      "dotnet": "Qodalis.Cli.Plugin.Databases"
    }
  }
}
