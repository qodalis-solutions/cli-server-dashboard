{
  "name": "@qodalis/cli-server-dashboard-kit",
  "version": "1.0.0-beta.31",
  "description": "Components, theme and extension API of the Qodalis CLI server dashboard: build pages that plugins add to the dashboard",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qodalis-solutions/cli-server-dashboard.git",
    "directory": "kit"
  },
  "keywords": [
    "qodalis",
    "qodalis-cli",
    "dashboard",
    "react",
    "tailwind"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/theme/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && tailwindcss -c tailwind.config.js -i src/styles.css -o dist/styles.css --minify",
    "build:example": "vite build -c example/vite.config.ts example"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "@testing-library/react": ">=14"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    }
  }
}
